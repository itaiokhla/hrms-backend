# ---------------------------------------------------------------------------
# Environment: development | test | staging | production
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# ---------------------------------------------------------------------------
# Database - Neon PostgreSQL
#
# DATABASE_URL           Least-privilege app role (created with
#                        `python -m app.cli setup-db-roles`). Row-level
#                        security is enforced for this role.
# SYSTEM_DATABASE_URL    Owner role (e.g. neondb_owner). Used only for login,
#                        signup, invitations, password reset and platform admin.
# MIGRATION_DATABASE_URL Owner role used by Alembic (defaults to SYSTEM_DATABASE_URL).
#
# Use Neon's *pooled* host (-pooler) for DATABASE_URL and keep sslmode=require.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://hrms_app:CHANGE_ME@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
SYSTEM_DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
MIGRATION_DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------------------
# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Cookies (COOKIE_SECURE must be true in production / HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Set true only when all traffic arrives via a trusted proxy (Next.js rewrite, load balancer)
TRUST_PROXY_HEADERS=false

# Public URL of the frontend (used in invitation links) and allowed CORS origins
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Email (optional; without SMTP, development mode prints codes/links to the console)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Files & face recognition
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880
FACE_RECOGNITION_THRESHOLD=0.45

# Payroll rules
DEFAULT_WORK_HOURS_PER_DAY=8
LATE_PENALTY_AMOUNT=100
TRIAL_DAYS=14

LOG_LEVEL=INFO
