# ---------------------------------------------------------------------------
# Environment: development | test | staging | production
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# ---------------------------------------------------------------------------
# Database - Neon PostgreSQL
#
# DATABASE_URL           Least-privilege app role (created with
#                        `python -m app.cli setup-db-roles`). Row-level
#                        security is enforced for this role.
# SYSTEM_DATABASE_URL    Owner role (e.g. neondb_owner). Used only for login,
#                        signup, invitations, password reset and platform admin.
# MIGRATION_DATABASE_URL Owner role used by Alembic (defaults to SYSTEM_DATABASE_URL).
#
# Use Neon's *pooled* host (-pooler) for DATABASE_URL and keep sslmode=require.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://hrms_app:CHANGE_ME@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
SYSTEM_DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
MIGRATION_DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---------------------------------------------------------------------------
# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Cookies (COOKIE_SECURE must be true in production / HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Set true only when all traffic arrives via a trusted proxy (Next.js rewrite, load balancer)
TRUST_PROXY_HEADERS=false

# Public URL of the frontend on the platform host. Links for tenants without a verified
# host use it; tenant hosts reuse its scheme and port. Plus allowed CORS origins.
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# White label: tenant hosts and custom domains (all optional; leave PLATFORM_BASE_DOMAIN
# empty for single-host mode, which behaves exactly as before)
#
# PLATFORM_HOSTS        hostnames (no port) of the platform itself
# PLATFORM_BASE_DOMAIN  every tenant gets <slug>.<base domain> (needs a wildcard DNS record
#                       and a wildcard certificate at the hosting layer)
# PROXY_SHARED_SECRET   32+ random characters, identical in the Next.js app. The original
#                       Host is trusted only with it; keep FastAPI unreachable from outside.
# CUSTOM_DOMAIN_CNAME_TARGET  the CNAME tenants point custom domains at
# DOMAIN_DNS_PROVIDER   dns (real DNS); "fixture" is for development and tests only
# TLS_PROVIDER          probe (TLS handshake check; certificates come from the hosting
#                       layer, e.g. on-demand TLS); "local-dev" is for development only
# COOKIE_DOMAIN must stay unset when tenant hosts are enabled.
# ---------------------------------------------------------------------------
# PLATFORM_HOSTS=app.example.com
# PLATFORM_BASE_DOMAIN=example.com
# PROXY_SHARED_SECRET=
# CUSTOM_DOMAIN_CNAME_TARGET=tenants.example.com
DOMAIN_DNS_PROVIDER=dns
TLS_PROVIDER=probe

# ---------------------------------------------------------------------------
# Email (optional; without SMTP, development mode prints codes/links to the console)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Files & face recognition
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880
FACE_RECOGNITION_THRESHOLD=0.45

# Attendance location tracking: shortest interval a company may choose (minutes).
# Must be at least 15 in staging/production; lower values are for accelerated browser tests only.
LOCATION_TRACKING_MIN_INTERVAL_MINUTES=15

# Payroll rules
DEFAULT_WORK_HOURS_PER_DAY=8
LATE_PENALTY_AMOUNT=100
TRIAL_DAYS=14

LOG_LEVEL=INFO
